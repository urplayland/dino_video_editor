{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dino Adventures sfx v1",
  "type": "object",
  "required": [
    "schema_version",
    "effects"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "effects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "description",
          "category",
          "source",
          "asset_path",
          "default_gain_db",
          "tags",
          "license"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "asset_path": {
            "type": "string",
            "minLength": 1
          },
          "default_gain_db": {
            "type": "number"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "preset_version": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "object"
          },
          "variations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "asset_path": {
                  "type": "string",
                  "minLength": 1
                },
                "duration_s": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "gain_db": {
                  "type": "number",
                  "minimum": -60,
                  "maximum": 12
                },
                "generator": {
                  "type": "string",
                  "minLength": 1
                },
                "seed": {
                  "type": "integer"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "provenance": {
                  "type": "object"
                },
                "license": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "asset_path",
                "duration_s"
              ],
              "anyOf": [
                {
                  "required": [
                    "generator",
                    "seed"
                  ]
                },
                {
                  "required": [
                    "sha256",
                    "provenance",
                    "license"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  }
}
