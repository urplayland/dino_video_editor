{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "sample",
        "draft",
        "verified",
        "approved"
      ]
    },
    "duration_s": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description"
        ]
      }
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scene_id": {
            "type": "string",
            "minLength": 1
          },
          "preset_id": {
            "type": "string",
            "minLength": 1
          },
          "preset_version": {
            "type": "string",
            "minLength": 1
          },
          "timestamp_s": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "duration_s": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "gain_db": {
            "type": "number",
            "minimum": -60,
            "maximum": 12
          },
          "variation": {
            "type": "string",
            "minLength": 1
          },
          "loop": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "sample",
              "draft",
              "verified",
              "approved"
            ]
          },
          "timing_basis": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "scene_id",
          "preset_id",
          "preset_version",
          "timestamp_s",
          "status"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "status",
    "duration_s",
    "scenes",
    "cues"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
